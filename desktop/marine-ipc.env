
# User session runtime directory
MARINE_IPC_DIR="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}/marine-sensors"

# Unix domain sockets
MARINE_SONAR_SOCKET="$MARINE_IPC_DIR/sonar.sock"
MARINE_DVL_SOCKET="$MARINE_IPC_DIR/dvl.sock"
MARINE_SERVO_SOCKET="$MARINE_IPC_DIR/servo.sock"
MARINE_CONTROLLER_SOCKET="$MARINE_IPC_DIR/controller.sock"
