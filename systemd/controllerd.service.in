[Unit]
Description=Marine Sensor Controller Daemon
After=systemd-tmpfiles-setup.service

[Service]
Type=simple
User=@INSTALL_USER@
Group=marine-ipc

WorkingDirectory=@REPO_DIR@
ExecStart=@CONTROLLERD_BIN@

EnvironmentFile=/etc/marine-sensors/ipc.env

Restart=on-failure
RestartSec=3

StandardInput=null
StandardOutput=journal
StandardError=journal

TimeoutStopSec=10

[Install]
WantedBy=multi-user.target