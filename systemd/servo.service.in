[Unit]
Description=Marine Servo Service
After=systemd-tmpfiles-setup.service

[Service]
Type=simple
User=root
Group=marine-ipc

ExecStart=/usr/local/bin/marine-servo --service

EnvironmentFile=/etc/marine-sensors/ipc.env

Restart=no

StandardInput=null
StandardOutput=journal
StandardError=journal

TimeoutStopSec=10

[Install]
WantedBy=multi-user.target